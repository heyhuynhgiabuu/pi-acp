{
  "name": "pi-acp",
  "version": "0.0.33",
  "description": "ACP adapter for pi coding agent",
  "license": "MIT",
  "author": "Sergii Kozak <svkozak@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/svkozak/pi-acp.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/svkozak/pi-acp/issues"
  },
  "homepage": "https://github.com/svkozak/pi-acp#readme",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "pi-coding-agent",
    "adapter"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-acp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "node --import tsx --test test/**/*.test.ts",
    "smoke": "node scripts/smoke-acp.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.26.0",
    "cross-spawn": "^7.0.6",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
